diff --git a/app/src/main/AndroidManifest.xml b/app/src/main/AndroidManifest.xml
index 3a4f037..8f6e253 100644
--- a/app/src/main/AndroidManifest.xml
+++ b/app/src/main/AndroidManifest.xml
@@ -30,8 +30,24 @@
     <uses-permission android:name="android.permission.FOREGROUND_SERVICE_SPECIAL_USE" />
     <uses-permission android:name="android.permission.REQUEST_INSTALL_PACKAGES"
         tools:ignore="RequestInstallPackagesPolicy" />
+    <!-- DisplayXR 3D: camera for the Lume Pad face tracker, and visibility of
+         the DisplayXR OpenXR runtime + Leia services from the game process. -->
+    <uses-permission android:name="android.permission.CAMERA" />
+    <uses-feature android:name="android.hardware.camera" android:required="false" />
+    <uses-feature android:name="android.hardware.camera.front" android:required="false" />
     <queries>
         <package android:name="com.mojang.minecraftpe" />
+        <intent>
+            <action android:name="org.khronos.openxr.OpenXRRuntimeService" />
+        </intent>
+        <provider android:authorities="org.khronos.openxr.runtime_broker" />
+        <package android:name="org.freedesktop.monado.openxr_runtime.in_process" />
+        <package android:name="org.freedesktop.monado.openxr_runtime.out_of_process" />
+        <intent>
+            <action android:name="org.freedesktop.monado.ipc.CONNECT" />
+        </intent>
+        <package android:name="com.leialoft.display.config" />
+        <package android:name="com.leia.headtrackingservice" />
         <intent>
             <action android:name="android.intent.action.VIEW" />
             <category android:name="android.intent.category.BROWSABLE" />
diff --git a/app/src/main/java/org/levimc/launcher/ui/activities/MainActivity.java b/app/src/main/java/org/levimc/launcher/ui/activities/MainActivity.java
index 161a736..e5be25d 100644
--- a/app/src/main/java/org/levimc/launcher/ui/activities/MainActivity.java
+++ b/app/src/main/java/org/levimc/launcher/ui/activities/MainActivity.java
@@ -125,8 +125,11 @@ import okhttp3.OkHttpClient;
         closeLauncherRestartAfterFirstDraw();
         setupNavBar();
         setupManagersAndHandlers();
-        if (!isInstanceShortcutIntent()) {
-            new GithubReleaseUpdater(this, "LiteLDev", "LeviLaunchroid", permissionResultLauncher).checkUpdateOnLaunch();
+        // DisplayXR 3D fork: no upstream self-update (it would install the
+        // stock launcher); ask for the camera so the Lume Pad can track eyes.
+        if (checkSelfPermission(android.Manifest.permission.CAMERA)
+                != android.content.pm.PackageManager.PERMISSION_GRANTED) {
+            requestPermissions(new String[]{android.Manifest.permission.CAMERA}, 3301);
         }
         showEulaIfNeeded();
         setupOnBackPressedCallback();
